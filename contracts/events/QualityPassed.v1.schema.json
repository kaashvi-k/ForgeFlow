{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulfillops.dev/contracts/events/QualityPassed.v1.schema.json",
  "title": "QualityPassed.v1",
  "description": "Quality Service recorded a passed inspection after inventory was reserved.",
  "allOf": [
    { "$ref": "EventEnvelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "QualityPassed" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "quality-service" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspectionId"],
          "properties": {
            "inspectionId": { "type": "string", "format": "uuid" },
            "reasonCode": { "type": ["string", "null"] },
            "reasonDetail": { "type": ["string", "null"] }
          }
        }
      }
    }
  ]
}
